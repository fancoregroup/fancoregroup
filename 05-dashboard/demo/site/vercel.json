{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(recrutamento|carreiras)/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(ats|carreiras)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/recrutamento",
      "destination": "/recrutamento/index.html"
    },
    {
      "source": "/recrutamento/",
      "destination": "/recrutamento/index.html"
    },
    {
      "source": "/carreiras",
      "destination": "/carreiras/index.html"
    },
    {
      "source": "/carreiras/",
      "destination": "/carreiras/index.html"
    },
    {
      "source": "/performance/estica",
      "destination": "/performance/estica/index.html"
    },
    {
      "source": "/performance/estica/",
      "destination": "/performance/estica/index.html"
    },
    {
      "source": "/performance/agrobar",
      "destination": "/performance/agrobar/index.html"
    },
    {
      "source": "/performance/agrobar/",
      "destination": "/performance/agrobar/index.html"
    },
    {
      "source": "/campanhas-setembro-2026",
      "destination": "/campanhas-setembro-2026/index.html"
    },
    {
      "source": "/campanhas-setembro-2026/",
      "destination": "/campanhas-setembro-2026/index.html"
    },
    {
      "source": "/inteligencia-geografica",
      "destination": "/inteligencia-geografica/index.html"
    },
    {
      "source": "/inteligencia-geografica/",
      "destination": "/inteligencia-geografica/index.html"
    },
    {
      "source": "/mapa-agrobar",
      "destination": "/mapa-agrobar/index.html"
    },
    {
      "source": "/mapa-agrobar/",
      "destination": "/mapa-agrobar/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
